test recipe-fresh-4 {Numeric expression strings are rejected before native preview calculations} -setup {
    ::recipe_fixture::setup
    set raw [::recipe_fixture::read [::recipe_fixture::path flow]]
    dict set raw espresso_hold_time {[start_espresso] + 5}
    ::recipe_fixture::write [::recipe_fixture::path flow] $raw
    rename ::profile::read_legacy ::profile::fixture_reader
    proc ::profile::read_legacy {args} {
        set ::recipe_fixture::reader_invoked 1
        return [::profile::fixture_reader {*}$args]
    }
    unset -nocomplain ::recipe_fixture::reader_invoked
} -body {
    set row [::aiden::recipe::make_record flow [::recipe_fixture::path flow]]
    list [dict get $row available] [dict get $row applyable] \
        [info exists ::recipe_fixture::reader_invoked] [string match {*numeric profile field*} [dict get $row error]]
} -cleanup {
    rename ::profile::read_legacy {}
    rename ::profile::fixture_reader ::profile::read_legacy
} -result {0 0 0 1}

test recipe-native-offset-1 {Synthetic negative offsets preserve stage structure, dose and source state} -setup {
    ::recipe_fixture::setup
} -body {
    set before [array get ::settings]
    set source_before [list [::recipe_fixture::bytes [::recipe_fixture::path gentle]] \
        [::recipe_fixture::bytes [::recipe_fixture::path advanced]]]
    set doses {}
    set stage_fields_preserved 1
    foreach id {gentle advanced} {
        set native [::recipe_fixture::read [::recipe_fixture::path $id]]
        dict set native grinder_dose_weight 35
        set fields [::aiden::recipe::fields $native]
        dict set fields temperature [expr {[dict get $fields temperature] - 1.5}]
        set actual [::aiden::recipe::adjusted $native $fields]
        if {$id eq "gentle"} {
            set simple_temperatures {}
            foreach key {espresso_temperature espresso_temperature_0 espresso_temperature_1 espresso_temperature_2 espresso_temperature_3} {
                lappend simple_temperatures [dict get $actual $key]
            }
        } else {
            set advanced_temperatures {}
            foreach a [dict get $actual advanced_shot] b [dict get $native advanced_shot] {
                lappend advanced_temperatures [dict get $a temperature]
                if {![::aiden::recipe::dict_equal [dict remove $a temperature] [dict remove $b temperature]]} {
                    set stage_fields_preserved 0
                }
            }
        }
        lappend doses [dict get $actual grinder_dose_weight]
    }
    set source_after [list [::recipe_fixture::bytes [::recipe_fixture::path gentle]] \
        [::recipe_fixture::bytes [::recipe_fixture::path advanced]]]
    list $simple_temperatures $advanced_temperatures $doses $stage_fields_preserved \
        [::aiden::recipe::dict_equal $before [array get ::settings]] \
        [expr {$source_before eq $source_after}] $::recipe_fixture::calls
} -result {{86.5 86.5 85.5 84.5 83.5} {92.5 91.0 88.5} {35.0 35.0} 1 1 1 {}}

test recipe-guard-4 {A native notice cannot commit a previously open Aiden recipe draft} -setup {
    ::recipe_fixture::setup
    ::aiden::recipe::begin
    dict set ::recipe_fixture::status current_page tankempty
    dict set ::recipe_fixture::status current_context tankempty
    set ::de1(current_context) tankempty
} -body {
    list [catch {::aiden::recipe::apply {yield 40}}] $::recipe_fixture::calls
} -result {1 {}}

removeDirectory $::recipe_fixture::root
cleanupTests
