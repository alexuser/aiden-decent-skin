    ::aiden::lifecycle::complete_hold
    list [dict get $p workflow_order] [dict get $p workflow_modes] [::lifecycle_fixture::value mode] \
        [::lifecycle_fixture::value fresh_start] $::lifecycle_fixture::hardware_calls
} -result {{espresso steam water flush} {espresso steam water} steam 1 {}}

test workflow-7 {Reset accepts a validated custom order and native water aliases} -body {
    set p [::aiden::lifecycle::reset {workflow americano mode_order {espresso hotwater flush} skipped_modes flush}]
    list [dict get $p mode_order] [dict get $p workflow_modes] [dict get $p primary_action]
} -result {{espresso water flush} {espresso water} wait}

test workflow-8 {Duplicate, unsupported, and non-espresso-first orders reject atomically} -setup {
    ::lifecycle_fixture::ready
} -body {
    set before [::aiden::lifecycle::presentation]
    set failures {}
    foreach order {{espresso steam steam} {espresso hotwater water} {espresso cleaning} {steam espresso} {}} {
        lappend failures [catch {::aiden::lifecycle::configure_workflow latte [dict create mode_order $order]}]
    }
    list $failures [expr {$before eq [::aiden::lifecycle::presentation]}]
} -result {{1 1 1 1 1} 1}

test workflow-9 {Skip validation agrees with saved workflow schema and stays atomic} -setup {
    ::lifecycle_fixture::ready
} -body {
    set before [::aiden::lifecycle::presentation]
    set failures {}
    foreach skipped {{flush flush} water espresso cleaning} {
        lappend failures [catch {::aiden::lifecycle::configure_workflow latte [dict create skipped_modes $skipped]}]
    }
    list $failures [expr {$before eq [::aiden::lifecycle::presentation]}]
} -result {{1 1 1 1} 1}

test workflow-10 {The retained espresso record keeps its Saved status through an unsaved flush operation} -setup {
    ::lifecycle_fixture::ready
    ::lifecycle_fixture::active
    ::lifecycle_fixture::finalized
    ::aiden::lifecycle::continue
    ::aiden::lifecycle::request start
