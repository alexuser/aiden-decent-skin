    list [dict get $p phase] [dict get $p stage_name] [dict get $p stage_advance_available] [dict get $p primary_action]
} -result {stop-requested Extracting 0 stop}

test stage-4 {Native stage rejection preserves stage and exposes its reason} -setup {
    ::lifecycle_fixture::ready
    ::lifecycle_fixture::active {stage_advance_verified 1 stage_advance_available 1 stage_name Preinfusion}
    ::aiden::lifecycle::request stage-advance
} -body {
    set p [::lifecycle_fixture::active {stage_advance_verified 1 stage_advance_available 1 stage_name Preinfusion \
        stage_advance_rejected 1 stage_advance_reason {No next stage}}]
    list [dict get $p stage_name] [dict get $p reason] [dict get $p stage_advance_pending]
} -result {Preinfusion {No next stage} 0}

test tare-1 {Live tare requests do not reset values, time, or native state} -setup {
    ::lifecycle_fixture::ready
    ::lifecycle_fixture::active
} -body {
