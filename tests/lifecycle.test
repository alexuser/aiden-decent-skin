test result-12 {The native operation recipe preserves advanced data even when current settings already changed} -setup {
    ::lifecycle_fixture::ready
} -body {
    set p [::lifecycle_fixture::active {profile_title {Future title} dose 25 \
        operation_recipe {profile_title {Native frozen} profile_id native dose 18 target_yield 36 target_temp 93 \
            profile_type settings_2c advanced_shot {{name Bloom seconds 10 temperature 92} {name Pour seconds 20 temperature 94}}}}]
    ::lifecycle_fixture::finalized
    set shot [::aiden::lifecycle::result]
    list [dict get $p profile_title] [dict get $shot profile_title] [dict get $shot recipe profile_type] \
        [llength [dict get $shot recipe advanced_shot]]
} -result {{Native frozen} {Native frozen} settings_2c 2}

test handoff-4 {Reset never reuses a presentation identity and an older hold cannot advance a new result} -setup {
    ::lifecycle_fixture::ready
    ::lifecycle_fixture::active
    ::lifecycle_fixture::finalized
} -body {
    set old [dict get [::aiden::lifecycle::operation_result] id]
    ::lifecycle_fixture::ready
    ::lifecycle_fixture::active
    ::lifecycle_fixture::finalized
    set new [dict get [::aiden::lifecycle::operation_result] id]
    list [expr {$old ne $new}] [dict get [::aiden::lifecycle::complete_hold $old] accepted] \
        [::lifecycle_fixture::value phase]
} -result {1 0 result}

test stage-5 {Native stage numbers acknowledge repeated textual stage names without inventing a stage} -setup {
    ::lifecycle_fixture::ready
    ::lifecycle_fixture::active {stage_advance_verified 1 stage_advance_available 1 stage_name Pour stage_number 2}
    ::aiden::lifecycle::request stage-advance
} -body {
    set p [::lifecycle_fixture::active {stage_advance_verified 1 stage_advance_available 1 stage_name Pour stage_number 3}]
    list [dict get $p stage_name] [dict get $p stage_advance_pending] [dict get $p stage_advance_available]
} -result {Pour 0 1}

test pure-1 {No exercised path invokes hardware, persistence, or a lifecycle timer} -body {
    set f [open [file join [file dirname [info script]] .. aiden lifecycle.tcl] r]
    set source [read $f]
    close $f
    list $::lifecycle_fixture::hardware_calls [regexp {(?m)^\s*after\s} $source] \
        [regexp {(?m)^\s*(start_espresso|start_idle|start_flush|start_steam|start_water|save_espresso_to_history)\s} $source]
} -result {{} 0 0}

cleanupTests
