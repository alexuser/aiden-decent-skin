} -result {active espresso:1 0 0}

test ordering-7 {A missed external start recovers an identified native record without changing prior history} -setup {
    ::lifecycle_fixture::ready
    ::lifecycle_fixture::active
    ::lifecycle_fixture::finalized
} -body {
    set first [::aiden::lifecycle::result]
    set p [::lifecycle_fixture::finalized {operation_id espresso:2 result_id espresso:2 history_id native-shot-2 \
        final_elapsed 30.5 final_weight 40 final_result {operation_id espresso:2 mode espresso \
            recipe {profile_title {Recovered second} dose 20 target_yield 40 target_temp 92} final_elapsed 30.5}}]
    list [llength [::aiden::lifecycle::history]] [dict get $p result profile_title] \
        [expr {$first eq [lindex [::aiden::lifecycle::history] 1]}] [dict get $p auto_handoff_available]
} -result {2 {Recovered second} 1 0}

