        [expr {$before eq [::aiden::lifecycle::presentation]}] $::lifecycle_fixture::hardware_calls
} -result {0 0 1 {}}

test specialist-1 {Native specialist activity blocks new modes and retains the Stop affordance} -setup {
    ::lifecycle_fixture::ready
} -body {
    set p [::aiden::lifecycle::ingest [::lifecycle_fixture::snapshot {state clean mode {} ready 0}]]
    list [dict get $p phase] [dict get $p primary_action] [dict get $p can_select_mode] \
        [dict get [::aiden::lifecycle::request start] accepted]
} -result {unknown-or-blocked stop 0 0}

test workflow-6 {Persisted custom ordering is consumed exactly and handoff still requires a fresh Start} -setup {
    ::lifecycle_fixture::ready
    ::aiden::lifecycle::configure_workflow latte {mode_order {espresso steam water flush} skipped_modes flush}
    ::lifecycle_fixture::active
    ::lifecycle_fixture::finalized
} -body {
