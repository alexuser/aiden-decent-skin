        [::lifecycle_fixture::value mode] [::lifecycle_fixture::value fresh_start] [llength [::aiden::lifecycle::history]] \
        $::lifecycle_fixture::hardware_calls
} -result {1 Complete 1 steam 1 1 {}}

test workflow-12 {An unclassified non-espresso completion still requires explicit continuation} -setup {
    ::lifecycle_fixture::ready
