} -body {
    set p [::lifecycle_fixture::finalized {mode flush operation_id flush:2 result_id flush:2 history_id {} result_saved 0}]
    list [dict get $p result mode] [dict get $p result_saved] [dict get $p result_state] \
        [dict get $p operation_result mode] [dict get $p operation_result_saved] [dict get $p operation_result_state]
} -result {espresso 1 Saved flush 0 Complete}

test workflow-11 {Verified ordinary flush completion permits a UI hold without requiring espresso history} -setup {
    ::lifecycle_fixture::ready
    ::lifecycle_fixture::active
    ::lifecycle_fixture::finalized
    ::aiden::lifecycle::continue
