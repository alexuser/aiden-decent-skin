        [dict get $p auto_handoff_available] [llength [::aiden::lifecycle::history]]
} -result {result {Actual short shot} 2.5 0 1}

test connection-4 {Disconnected native Sleep cannot override the unknown connection condition} -body {
    ::aiden::lifecycle::reset
    set p [::aiden::lifecycle::ingest {state sleep native_state Sleep connected 0 ready 0}]
    list [dict get $p phase] [dict get $p status] [dict get $p primary_action]
} -result {unknown-or-blocked {Connection lost} wait}

test connection-5 {A connected native fatal error retains Stop and never looks ready} -setup {
