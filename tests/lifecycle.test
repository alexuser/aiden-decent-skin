        [dict get $p elapsed] [dict get $p primary_action] [llength [::aiden::lifecycle::history]]
} -result {start-requested 0 0 {} stop 1}

test request-6 {A bare completion flag also cannot acknowledge a first pending Start} -setup {
    ::lifecycle_fixture::ready
    ::aiden::lifecycle::request start
} -body {
