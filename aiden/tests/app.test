} -result {{} 1}

# Real mode/workflow transactions run in a child interpreter. The normal
# controller fixture retains its narrow mode stubs, and every native API in
# this child is a recorder. Only a disposable workflow file can be written.
proc ::fixture::stale_draft_probe {kind departure} {
    set dir [makeDirectory [file join $::aiden::root draft-[clock clicks]]]
    set child [interp create]
    set code [catch {
        $child eval [list namespace eval ::aiden [list variable root $dir]]
        $child eval [list source [file join $::root lifecycle.tcl]]
        $child eval [list source [file join $::root modes.tcl]]
        $child eval [list source [file join $::root app.tcl]]
        $child eval {namespace eval ::fixture {variable calls {}; variable screen aiden_home; variable snapshot_failure 0; variable recipe_failure 0; variable render_failures 0}}
        foreach command {::aiden::core::snapshot ::aiden::core::command ::aiden::recipe::working ::aiden::recipe::cancel \
            ::aiden::ui::show ::aiden::ui::render ::dui ::homedir ::page_show ::aiden::app::native_state_change} {
            $child eval [list namespace eval [namespace qualifiers $command] {}]
            $child eval [list proc $command [info args $command] [info body $command]]
        }
        $child eval {
            rename ::aiden::ui::render ::fixture::render
            proc ::aiden::ui::render {snapshot} {
                ::fixture::render $snapshot
                # Match the production view's polled active-operation takeover.
                if {[::aiden::app::get $snapshot busy 0] && [string match aiden_* $::fixture::screen]} {
                    ::aiden::ui::show aiden_home
                }
            }
            proc ::aiden::ui::set_mode_settings {args} {}
            proc ::aiden::ui::set_context {args} {}
            proc ::save_settings {} {lappend ::fixture::calls save_settings}
            proc ::de1_send_steam_hotwater_settings {} {lappend ::fixture::calls send_settings}
            array set ::settings {flush_seconds 5 flush_flow 2.9 steam_timeout 62 steam_flow 80 steam_temperature 170 steam_disabled 0 water_temperature 85 water_volume 50 hotwater_flow 10 water_time_max 60 water_stop_on_scale 1}
            array set ::de1 {scale_device_handle 0 in_eco_steam_mode 0 steam_disable_toggle 1}
            ::aiden::modes::configure -state_file [file join $::aiden::root workflow.tcl]
            ::aiden::lifecycle::reset
        }
        $child eval [list set ::fixture::state $::fixture::state]
        $child eval [list set ::fixture::idle_state $::fixture::state]
        $child eval [list set ::fixture::kind $kind]
        $child eval [list set ::fixture::departure $departure]
        set result [$child eval {
            if {$::fixture::kind eq {mode}} {
                ::aiden::app::action mode_settings flush
                ::aiden::app::action mode_edit flush flush_seconds 11
                set pending $::aiden::app::mode_draft
                set apply [list ::aiden::app::action mode_apply flush $pending]
            } else {
                ::aiden::app::action workflow
                ::aiden::app::action workflow_select latte
                set apply {::aiden::app::action workflow_apply latte}
            }
            set active_guard not-applicable
            if {$::fixture::departure in {native poll}} {
                dict set ::fixture::state native_state Espresso
                dict set ::fixture::state state espresso
                dict set ::fixture::state mode espresso
                dict set ::fixture::state editable 0
                dict set ::fixture::state ready 0
                if {$::fixture::departure eq {native}} {
                    ::aiden::app::state_change Espresso
                } else {::aiden::app::tick}
                set ::fixture::calls {}
                {*}$apply
                if {$::fixture::kind eq {mode}} {
                    set active_guard [expr {$::settings(flush_seconds) == 5 && $::fixture::calls eq {}}]
                } else {
                    set active_guard [expr {[dict get [::aiden::modes::workflow get] selected] eq {espresso} && ![file exists [file join $::aiden::root workflow.tcl]]}]
                }
                set ::fixture::state $::fixture::idle_state
            } else {::aiden::app::action home}
            set on_home [expr {$::fixture::screen eq {aiden_home}}]
            set ::fixture::calls {}
            if {$::fixture::kind eq {mode}} {
                set retained [dict exists $::aiden::modes::drafts flush]
                {*}$apply
                set value $::settings(flush_seconds)
                set persisted [expr {{save_settings} in $::fixture::calls}]
            } else {
                set retained [expr {$::aiden::modes::workflow_draft ne {}}]
                {*}$apply
                set value [dict get [::aiden::modes::workflow get] selected]
                set persisted [file exists [file join $::aiden::root workflow.tcl]]
            }
            list $on_home $active_guard $retained $value $persisted
        }]
    } problem options]
    interp delete $child
    removeDirectory $dir
    if {$code} {return -options $options $problem}
    return $result
}
test mode-close-stale-apply-1 {Closing a mode draft blocks later Apply without reopening} -setup {reset_fixture} -body {
    ::fixture::stale_draft_probe mode home
} -result {1 not-applicable 0 5 0}
test mode-takeover-stale-apply-1 {Active guard rejects Apply, and completed takeover cannot revive its draft} -setup {reset_fixture} -body {
    ::fixture::stale_draft_probe mode native
} -result {1 1 0 5 0}
test workflow-close-stale-apply-1 {Closing a workflow draft blocks later Apply without reopening} -setup {reset_fixture} -body {
    ::fixture::stale_draft_probe workflow home
} -result {1 not-applicable 0 espresso 0}
test workflow-takeover-stale-apply-1 {Active guard rejects workflow Apply, and completed takeover cannot revive its draft} -setup {reset_fixture} -body {
    ::fixture::stale_draft_probe workflow native
} -result {1 1 0 espresso 0}
test mode-poll-takeover-stale-apply-1 {A polled operation discards the mode draft before the view leaves its editor} -setup {reset_fixture} -body {
    ::fixture::stale_draft_probe mode poll
} -result {1 1 0 5 0}
test workflow-poll-takeover-stale-apply-1 {A polled operation discards the workflow draft before the view leaves its editor} -setup {reset_fixture} -body {
    ::fixture::stale_draft_probe workflow poll
} -result {1 1 0 espresso 0}
after cancel $::aiden::app::timer
if {$::aiden::app::hold_timer ne {}} {after cancel $::aiden::app::hold_timer}
file delete -force $::aiden::root
cleanupTests
