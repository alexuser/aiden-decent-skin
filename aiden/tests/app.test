    reset_fixture
    set ::aiden::app::native_view 1
    ::aiden::app::sample
    set ::aiden::app::native_view
} -result 0
namespace eval ::aiden::distribution {
    proc boot_success {} {lappend ::fixture::calls boot_success}
    proc boot_failure {problem options} {lappend ::fixture::calls [list boot_failure $problem]}
}
test standalone-boot-success-1 {Standalone is acknowledged only after mounting and rendering} -body {
    reset_fixture
    set ::aiden::standalone 1
    set ::aiden::app::started 0
    ::aiden::app::boot
    list [lindex $::fixture::calls end] $::aiden::app::started
} -result {boot_success 1}
test standalone-boot-failure-1 {Asynchronous mount failure reaches standalone recovery without actuation} -body {
    reset_fixture
    set ::aiden::app::started 0
    rename ::aiden::ui::mount ::aiden::ui::original_mount
    proc ::aiden::ui::mount {} {error {synthetic mount failure}}
    ::aiden::app::boot
    rename ::aiden::ui::mount {}
    rename ::aiden::ui::original_mount ::aiden::ui::mount
    list $::fixture::calls $::aiden::app::started $::aiden::app::timer
} -result {{observers {boot_failure {synthetic mount failure}}} 0 {}}
unset ::aiden::standalone
test standalone-module-failure-1 {Standalone module errors escape bootstrap for loader recovery} -body {
    set dir [makeDirectory aiden-bootstrap-failure]
    file copy -force [file join $root bootstrap.tcl] [file join $dir bootstrap.tcl]
    set fd [open [file join $dir core.tcl] w]
    puts $fd {error {synthetic module failure}}
    close $fd
    set child [interp create]
    $child eval {namespace eval ::aiden {variable standalone 1}}
    set code [catch {$child eval [list source [file join $dir bootstrap.tcl]]} problem]
    interp delete $child
    removeDirectory $dir
    list $code $problem
} -result {1 {synthetic module failure}}

proc ::fixture::poll_count {} {
    set count 0
    foreach id [after info] {
        if {[lindex [after info $id] 0] eq {::aiden::app::tick}} {incr count}
    }
    return $count
}
test sample-failure-actions-1 {A fresh sample failure prevents Start and both Apply dispatchers} -setup {
    reset_fixture
    ::aiden::app::tick
    set ::fixture::snapshot_failure 1
} -body {
    foreach action {{primary} {recipe_apply {yield 40}} {mode_apply flush {flush_seconds 11}}} {
        ::aiden::app::action {*}$action
    }
    list $::fixture::calls $::aiden::app::notice [::fixture::poll_count]
} -result {{} {synthetic snapshot failure} 1}

test poll-failure-recovery-1 {Repeated failed polls replace one timer, dispatch nothing, and recover} -setup {
    reset_fixture
    ::aiden::app::tick
    set ::fixture::snapshot_failure 1
} -body {
    set replaced 1
    set single 1
    for {set i 0} {$i < 10} {incr i} {
        set previous $::aiden::app::timer
        ::aiden::app::tick
        if {![catch {after info $previous}]} {set replaced 0}
        if {[::fixture::poll_count] != 1} {set single 0}
    }
    set ::fixture::snapshot_failure 0
    ::aiden::app::tick
    list $replaced $single [::fixture::poll_count] $::fixture::calls \
        [dict get $::fixture::rendered phase] [dict get $::fixture::rendered primary_enabled]
} -result {1 1 1 {} prepared 1}

test poll-pending-stop-recovery-1 {Polling failures never replay a pending Start or Stop} -setup {
    reset_fixture
    ::aiden::app::action primary
    dict set ::fixture::state pending start
    ::aiden::app::action stop
    dict set ::fixture::state pending stop
    ::aiden::app::tick
    set ::fixture::recipe_failure 1
} -body {
    for {set i 0} {$i < 3} {incr i} {::aiden::app::tick}
    set ::fixture::recipe_failure 0
    ::aiden::app::tick
    list $::fixture::calls [::fixture::poll_count] \
        [dict get $::fixture::rendered phase] [dict get $::fixture::rendered primary_enabled]
} -result {{{command start espresso} {command stop}} 1 stop-requested 0}

