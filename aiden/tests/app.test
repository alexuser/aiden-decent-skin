test primary-fallback-core-error-1 {Earlier active presentation cannot authorize Stop when the fresh core read also fails} -setup {
    reset_fixture
    dict set ::fixture::state state espresso
    dict set ::fixture::state native_state Espresso
    dict set ::fixture::state mode espresso
    dict set ::fixture::state editable 0
    dict set ::fixture::state ready 0
    ::aiden::app::tick
    set ::fixture::recipe_failure 1
    set ::fixture::snapshot_failure 1
