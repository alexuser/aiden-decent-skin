test original-route-rejected-1 {Core rejection still prevents Original view and retains presentation ownership} -setup {
    reset_fixture
    rename ::aiden::core::route ::fixture::saved_original_route
    proc ::aiden::core::route {target} {error {Waiting for machine confirmation of Stop; navigation is locked}}
} -body {
