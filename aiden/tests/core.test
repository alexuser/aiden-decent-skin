        [dict get $acknowledged pending] [dict get $acknowledged operation_reconciled] \
        $::transport_fixture::sent $::transport_fixture::native_calls
} -cleanup {::transport_fixture::cleanup} -result [list stop 0 stop 0 [list [list write RequestedState \x02] [list read StateInfo 0]] 1]

