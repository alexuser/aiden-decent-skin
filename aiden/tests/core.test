# SPDX-License-Identifier: GPL-3.0-only
# Fake installed-core APIs only: no BLE, Tk, Android, or espresso machine.
package require tcltest 2
namespace import ::tcltest::*
# An installed native app is optional source evidence, never a test dependency.
# Public tests run without a private tablet snapshot. Opt in with a directory
# containing history_viewer.tcl to verify the corresponding installed API.
set native_history_reference {}
if {[info exists ::env(AIDEN_NATIVE_REFERENCE)]} {
    set native_history_reference [file join $::env(AIDEN_NATIVE_REFERENCE) history_viewer.tcl]
}
testConstraint nativeHistorySource [expr {$native_history_reference ne {} && [file readable $native_history_reference]}]
namespace eval ::core_fixture {
    variable calls {}
    variable registrations {}
    variable page aiden_home
    variable finalizing 0
    variable reporting 1
    variable fail_action {}
    variable vectors [dict create espresso_elapsed {0 1 2} espresso_pressure {0 4 NaN}]
    variable pages {aiden_home off settings_1 settings_3 settings_4 extensions descale_prepare history_viewer}
    variable legacy_pages {}
    variable legacy_backgrounds {}
    proc setup {} {
        variable calls; set calls {}
        variable registrations; set registrations {native_history_listener}
        variable page; set page aiden_home
        variable finalizing; set finalizing 0
        variable reporting; set reporting 1
        variable fail_action; set fail_action {}
        variable vectors; set vectors [dict create espresso_elapsed {0 1 2} espresso_pressure {0 4 NaN}]
        variable pages; set pages {aiden_home off settings_1 settings_3 settings_4 extensions descale_prepare history_viewer}
        variable legacy_pages; set legacy_pages {}
        variable legacy_backgrounds; set legacy_backgrounds {}
        set ::android 1
        set ::undroid 0
        array unset ::settings
        array set ::settings {profile_filename gentle profile_title {Gentle and sweet} \
            settings_profile_type settings_2a grinder_dose_weight 18 final_desired_shot_weight 36 \
            espresso_temperature 93 scale_bluetooth_address {} stress_test 0 \
            start_espresso_only_if_scale_connected 0 ghc_is_installed 1 steam_timeout 30 steam_disabled 0 \
            steam_temperature 150 espresso_clock 1000 history_saved 0 should_save_history 1}
        array unset ::de1
        array set ::de1 {state 2 substate 0 device_handle 11 scale_device_handle 22 \
            current_context aiden_home scale_weight 0 head_temperature 92.7 \
            steam_heater_temperature 145 in_eco_steam_mode 0 final_espresso_weight 0 \
            current_frame_number 0 app_autostop_triggered False}
        array unset ::timers
        array set ::timers {espresso_start 0 espresso_stop 0}
        array set ::de1_num_state {0 Sleep 1 GoingToSleep 2 Idle 4 Espresso 5 Steam 6 HotWater 11 FatalError 15 HotWaterRinse}
        array set ::de1_substate_types {0 ready 1 heating 2 {final heating} 4 preinfusion 5 pouring 6 ending 200 Error_NaN}
        unset -nocomplain ::idle_next_step ::settings_optional_callback ::currently_connecting_scale_handle
        set ::aiden::core::hook_flags {}
        set ::aiden::core::pending_request {}
        set ::aiden::core::observed_operation {}
        set ::aiden::core::completed_result {}
        set ::aiden::core::last_state_event {}
        set ::aiden::core::event_sequence 0
    }
    proc native_event {this sub previous old_sub time} {
        foreach {num name} [array get ::de1_num_state] {
            if {$name eq $this} {set ::de1(state) $num}
        }
        foreach {num name} [array get ::de1_substate_types] {
            if {$name eq $sub} {set ::de1(substate) $num}
        }
        set event [dict create this_state $this this_substate $sub previous_state $previous \
            previous_substate $old_sub event_time $time]
        ::aiden::core::observe_state $event
        return $event
    }
    proc flowing {} {
        set ::timers(espresso_start) 1000000
        set ::timers(espresso_stop) 0
        native_event Espresso pouring Idle ready 1000.0
    }
    proc end_flow {} {
        set ::timers(espresso_stop) 1031500
        native_event Idle ready Espresso pouring 1031.5
    }
    proc complete {{saved 1}} {
        set ::de1(final_espresso_weight) 42.7
        set ::settings(history_saved) $saved
        set ::settings(history_saved_shot_filename) [file join /history [clock format 1000 -format %Y%m%dT%H%M%S].shot]
        ::aiden::core::observe_complete [dict create this_state Idle this_substate ready \
            previous_state Espresso previous_substate pouring event_time 1031.5]
    }
}

foreach name {start_espresso start_flush start_steam start_water start_idle start_sleep start_next_step ble_connect_to_scale} {
    proc ::$name {} [format {
        lappend ::core_fixture::calls %s
        if {$::core_fixture::fail_action eq "%s"} {error {Transport outcome uncertain}}
        return {}
    } $name $name]
}
namespace eval ::device::scale {}
proc ::device::scale::tare {} {lappend ::core_fixture::calls tare}
proc ::device::scale::is_reporting {} {return $::core_fixture::reporting}
namespace eval ::de1::event::apply {}
proc ::de1::event::apply::after_flow_complete_is_pending {} {return $::core_fixture::finalizing}
namespace eval ::de1::event::listener {}
foreach name {on_all_state_change_add on_disconnect_add after_flow_complete_add} {
    proc ::de1::event::listener::$name {args} [format {
        lappend ::core_fixture::registrations [list %s {*}$args]
    } $name]
}
proc ::dui {args} {
    if {$args eq {canvas}} {return ::core_fixture::canvas}
    switch -- [lrange $args 0 1] {
        {page current} {return $::core_fixture::page}
        {page exists} {return [expr {[lindex $args 2] in $::core_fixture::pages}]}
        {page items} {
            if {[lindex $args 2] in $::core_fixture::legacy_pages} {return {101 202}}
            return {}
        }
        {page load} {
            lappend ::core_fixture::calls [list navigation [lindex $args 2]]
            set ::core_fixture::page [lindex $args 2]
            set ::de1(current_context) $::core_fixture::page
            return
        }
        default {error "Unexpected DUI call: $args"}
    }
}
proc ::core_fixture::canvas {args} {
    if {[lrange $args 0 1] ne {find withtag}} {error {Canvas read-only fence}}
    if {[lindex $args 2] in $::core_fixture::legacy_backgrounds} {return 303}
    return {}
}
proc ::backup_settings {} {lappend ::core_fixture::calls native_backup}
proc ::fill_extensions_listbox {} {lappend ::core_fixture::calls native_extensions_catalog}
namespace eval ::plugins::DYE {}
proc ::plugins::DYE::open {args} {lappend ::core_fixture::calls [list dye {*}$args]}
foreach name {espresso_elapsed espresso_pressure} {
    proc ::$name {operation first last} [format {
        if {$operation ne "range"} {error {Read-only vector fence}}
        return [dict get $::core_fixture::vectors %s]
    } $name]
}
foreach name {page_show show_settings start_button_ready watertemp steamtemp pressure waterflow waterweight_text save_this_espresso_to_history de1_send_state} {
    proc ::$name {args} {error {HARDWARE / MUTATING DISPLAY HELPER FENCE}}
}
set before_source_calls $::core_fixture::calls
set before_source_registrations $::core_fixture::registrations
source [file join [file dirname [info script]] .. core.tcl]

test source-1 {Sourcing does not dispatch, register listeners, or touch app state} -body {
    list [expr {$before_source_calls eq $::core_fixture::calls}] \
        [expr {$before_source_registrations eq $::core_fixture::registrations}] [info exists ::de1]
} -result {1 1 0}

test snapshot-1 {Read-only snapshot preserves native settings/timers and zero sensor reading} -setup {
    ::core_fixture::setup
} -body {
    set before [list [lsort [array get ::de1]] [lsort [array get ::settings]] [lsort [array get ::timers]]]
    set s [::aiden::core::snapshot]
    set after [list [lsort [array get ::de1]] [lsort [array get ::settings]] [lsort [array get ::timers]]]
    list [expr {$before eq $after}] $::core_fixture::calls $::core_fixture::registrations \
        [dict get $s native_state] [dict get $s ready] [dict get $s elapsed] [dict get $s weight] \
        [dict get $s graph_samples]
} -result {1 {} native_history_listener Idle 1 {} 0 {}}

test snapshot-2 {Absent connection/state/sensor fields remain unknown with unavailable values} -setup {
    ::core_fixture::setup
    array unset ::de1
    array unset ::settings
} -body {
    set s [::aiden::core::snapshot]
    list [dict get $s state] [dict get $s connection_status] [dict get $s connected] \
        [dict get $s ready] [dict get $s editable] [dict get $s scale_status] \
        [dict get $s weight] [dict get $s temperature] [dict get $s flow_ended] $::core_fixture::calls
} -result {unknown unknown 0 0 0 unknown {} {} 0 {}}

test connection-1 {Native opaque BLE handles and nonzero numeric handles permit current read-only telemetry} -setup {
    ::core_fixture::setup
    set ::settings(scale_bluetooth_address) scale-configured
} -body {
    set results {}
    foreach handle {ble#DE1-opaque ble#scale-opaque -7 11} {
        set ::de1(device_handle) $handle
        set ::de1(scale_device_handle) $handle
        set before [list [lsort [array get ::de1]] [lsort [array get ::settings]]]
        set s [::aiden::core::snapshot]
        set after [list [lsort [array get ::de1]] [lsort [array get ::settings]]]
        lappend results [list [dict get $s connected] [dict get $s connection_status] \
            [dict get $s ready] [dict get $s scale_connected] [dict get $s weight] [expr {$before eq $after}]]
    }
    list $results $::core_fixture::calls
} -result {{{1 connected 1 1 0 1} {1 connected 1 1 0 1} {1 connected 1 1 0 1} {1 connected 1 1 0 1}} {}}

test connection-2 {Native zero is disconnected; empty or absent handles remain unknown and block commands} -setup {
    ::core_fixture::setup
    set ::settings(scale_bluetooth_address) scale-configured
} -body {
    set results {}
    foreach handle {0 0.0 {}} {
        set ::de1(device_handle) $handle
        set ::de1(scale_device_handle) $handle
        set s [::aiden::core::snapshot]
        lappend results [list [dict get $s connected] [dict get $s connection_status] \
            [dict get $s scale_connected] [dict get $s scale_status] \
            [dict get $s ready] [catch {::aiden::core::command stop}]]
    }
    unset ::de1(device_handle) ::de1(scale_device_handle)
    set s [::aiden::core::snapshot]
    lappend results [list [dict get $s connected] [dict get $s connection_status] \
        [dict get $s scale_connected] [dict get $s scale_status] \
        [dict get $s ready] [catch {::aiden::core::command stop}]]
    list $results $::core_fixture::calls
} -result {{{0 disconnected 0 disconnected 0 1} {0 disconnected 0 disconnected 0 1} {0 unknown 0 unknown 0 1} {0 unknown 0 unknown 0 1}} {}}

test connection-3 {DE1 sentinel one is blocked on Android and qualified as simulation only for explicit desktop runtime} -setup {
    ::core_fixture::setup
    set ::de1(device_handle) 1
} -body {
    set android_snapshot [::aiden::core::snapshot]
    set refused [catch {::aiden::core::command start espresso}]
    set ::android 0
    set desktop [::aiden::core::snapshot]
    unset ::android
    set unspecified [::aiden::core::snapshot]
    list [dict get $android_snapshot connected] [dict get $android_snapshot connection_status] $refused \
        [dict get $desktop connected] [dict get $desktop connection_status] \
        [dict get $unspecified connected] [dict get $unspecified connection_status] $::core_fixture::calls
} -result {0 unknown 1 1 simulated 0 unknown {}}

