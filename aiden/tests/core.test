test routing-original-warmup-guards-1 {Original warm-up routing retains context, pending, finalization, unresolved flow and stress guards} -body {
    set failures {}
    foreach reason {stale_context pending_start pending_stop finalizing active_flow unresolved_flow_heating unresolved_flow_ready unknown_native stress_test idle_next_step} {
        foreach target {original native_home} {
            ::core_fixture::setup
            set ::de1(substate) 1
            switch -- $reason {
                stale_context {set ::de1(current_context) tankempty}
                pending_start {set ::aiden::core::pending_request {action start id 1 mode espresso new_operation 1}}
                pending_stop {set ::aiden::core::pending_request {action stop id 1 mode espresso new_operation 1}}
                finalizing {set ::core_fixture::finalizing 1}
                active_flow {::core_fixture::flowing}
                unresolved_flow_heating - unresolved_flow_ready {
                    ::core_fixture::flowing
                    # Raw Idle without the flow-ending event does not prove an
                    # observed operation ended. Retain the original core data.
                    set ::de1(state) 2
                    set ::de1(substate) [expr {$reason eq {unresolved_flow_ready} ? 0 : 1}]
                }
                unknown_native {set ::de1(state) 999}
                stress_test {set ::settings(stress_test) 1}
                idle_next_step {set ::idle_next_step espresso}
            }
            if {![catch {::aiden::core::route $target}] || $::core_fixture::calls ne {}} {
                lappend failures [list $reason $target $::core_fixture::calls]
            }
        }
    }
    set failures
} -result {}

