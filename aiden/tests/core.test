        [dict get $disconnected scale_status] [dict get $disconnected weight] $::core_fixture::calls
} -result {stale {} 23.4 disconnected {} {}}

test commands-1 {A Start request does not invent flowing state or an elapsed timer; duplicates are blocked} -setup {
