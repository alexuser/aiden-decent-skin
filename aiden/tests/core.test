test routing-7 {Offline history viewing preserves Sleep/disconnected state and the working recipe} -setup {
    ::core_fixture::setup
    set ::de1(state) 0
    set ::de1(device_handle) 0
} -body {
    set before [lsort [array get ::settings]]
    ::aiden::core::route history
    set s [::aiden::core::snapshot]
    list [dict get $s native_state] [dict get $s connected] [dict get $s ready] \
