namespace eval ::transport_fixture {
    variable sent {}
    variable native_calls 0
    variable next_return 1
    proc setup {} {
        ::core_fixture::setup
        variable sent; set sent {}
        variable native_calls; set native_calls 0
        variable next_return; set next_return 1
        package provide de1_comms 1.1
        package provide de1_bluetooth 1.1
        set ::de1(suuid) service
        set ::de1(cuuid_02) requested_state
        set ::de1(cuuid_0E) state_info
        set ::de1(cmdstack) {}
        set ::de1(wrote) 0
        array set ::de1_state [list Idle \x02 Espresso \x04]
        rename ::start_idle ::transport_fixture::saved_start_idle
        proc ::start_idle {} {
            lappend ::core_fixture::calls start_idle
            userdata_append {go idle} [list de1_comm write RequestedState $::de1_state(Idle)] 1
        }
        proc ::userdata_append {comment cmd {vital 0}} {
            lappend ::de1(cmdstack) [list $comment $cmd $vital]
            ::transport_fixture::run_next
        }
        proc ::de1_comm {action command_name {value 0}} {
            lappend ::transport_fixture::sent [list $action $command_name $value]
            return $::transport_fixture::next_return
        }
        proc ::de1_ble_handler {event data} {
            incr ::transport_fixture::native_calls
            if {$event ne "characteristic" || [dict get $data state] ne "connected"} {return}
            set access [dict get $data access]
            if {$access in {w r}} {
                set ::de1(wrote) 0
                ::transport_fixture::run_next
            }
            if {$access in {r c} && [dict get $data cuuid] eq $::de1(cuuid_0E)} {
                set value [dict get $data value]
                if {[string length $value] != 2} {return}
                binary scan $value cc state substate
                set old $::de1_num_state($::de1(state))
                set old_sub $::de1_substate_types($::de1(substate))
                set ::de1(state) [expr {$state & 255}]
                set ::de1(substate) [expr {$substate & 255}]
                set this $::de1_num_state($::de1(state))
                set sub $::de1_substate_types($::de1(substate))
                if {$this ne $old || $sub ne $old_sub} {
                    ::core_fixture::native_event $this $sub $old $old_sub \
                        [expr {$::core_fixture::now / 1000.0}]
                }
            }
        }
        ::aiden::core::install_event_hooks
    }
    proc cleanup {} {
        foreach api {::userdata_append ::de1_comm ::de1_ble_handler ::start_idle} {rename $api {}}
        rename ::transport_fixture::saved_start_idle ::start_idle
        package forget de1_comms de1_bluetooth
        array unset ::de1_state
    }
    proc run_next {} {
        if {$::de1(wrote) || $::de1(cmdstack) eq {}} {return}
        set head [lindex $::de1(cmdstack) 0]
        set rest [lrange $::de1(cmdstack) 1 end]
        set ::de1(wrote) 1
        set result [{*}[lindex $head 1]]
        if {$result ne "1"} {set ::de1(wrote) 0; return}
        set ::de1(cmdstack) $rest
        set ::de1(previouscmd) [lindex $head 1]
    }
    proc packet {access value {handle 11} {cuuid {}}} {
        if {$cuuid eq {}} {
            set cuuid [expr {$access eq "w" ? "requested_state" : "state_info"}]
        }
        ::de1_ble_handler characteristic [dict create handle $handle state connected \
            suuid service cuuid $cuuid access $access value $value]
    }
    proc stop_pending {} {
        ::aiden::core::command start espresso
        ::aiden::core::command stop
    }
}

test reconciliation-1 {Cached Idle, repeated snapshots, and ACK alone do not reconcile a no-flow Stop} -setup {
    ::transport_fixture::setup
    ::core_fixture::native_event Idle ready Idle ready 999.0
    ::transport_fixture::stop_pending
} -body {
