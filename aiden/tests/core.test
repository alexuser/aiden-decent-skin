        [dict get $settling weight] [dict get $final result_finalized] [dict get $final result_saved] \
        [dict get $final final_weight] [dict get $final final_weight_quality] $::core_fixture::calls
} -result {1 0 31.5 41.2 1 1 42.7 native_final_estimate {}}

